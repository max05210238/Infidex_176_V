# Git LFS tracking for large binary assets in this repo.
# Requires git-lfs installed locally (https://git-lfs.com) and `git lfs install` run once.

*.max  filter=lfs diff=lfs merge=lfs -text
*.stl  filter=lfs diff=lfs merge=lfs -text
*.fbx  filter=lfs diff=lfs merge=lfs -text
*.3mf  filter=lfs diff=lfs merge=lfs -text
*.obj  filter=lfs diff=lfs merge=lfs -text
*.zip  filter=lfs diff=lfs merge=lfs -text

# The PDF manual is small; keep it as a normal git file (not LFS).
