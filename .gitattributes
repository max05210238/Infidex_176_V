# Binary file types — mark as binary so git doesn't attempt line-ending
# conversion or textual diffs. No file in this repo exceeds GitHub's 100 MB
# per-file limit, so Git LFS is not required.

*.max  binary
*.stl  binary
*.fbx  binary
*.3mf  binary
*.obj  binary
*.dae  binary
*.zip  binary
*.pdf  binary
